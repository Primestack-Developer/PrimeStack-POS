<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primestack_primary"
            android:text="New Transaction"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="16dp"
            android:gravity="center" />

        <!-- Amount display -->
        <TextView
            android:id="@+id/tvTxAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AED 0.00"
            android:textColor="@color/primestack_primary"
            android:textSize="36sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="20dp"
            android:layout_marginTop="8dp"
            android:background="@color/primestack_light_gray" />

        <!-- ── TRANSACTION TYPE ──────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Transaction Type"
            android:textColor="@color/primestack_gray"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTxSale"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="SALE"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@color/primestack_primary"
                android:textColor="@color/white"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnTxPreAuth"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="PRE-AUTH"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@color/primestack_light_gray"
                android:textColor="@color/primestack_primary"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnTxVoid"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="VOID"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@color/primestack_light_gray"
                android:textColor="@color/primestack_danger"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnTxRefund"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="REFUND"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@color/primestack_light_gray"
                android:textColor="@color/primestack_danger"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Selected type indicator -->
        <TextView
            android:id="@+id/tvSelectedType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selected: SALE"
            android:textColor="@color/primestack_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="8dp"
            android:layout_marginTop="4dp" />

        <!-- ── PROCESSING MODE ───────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Processing Mode"
            android:textColor="@color/primestack_gray"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnModeOnline"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                android:text="🌐 ONLINE"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@color/primestack_success"
                android:textColor="@color/white"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnModeOffline"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                android:text="📵 OFFLINE"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@color/primestack_light_gray"
                android:textColor="@color/primestack_secondary"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ONLINE: Card charged immediately via Stripe\nOFFLINE: Stored on device with STN code, sync later"
            android:textColor="@color/primestack_gray"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
