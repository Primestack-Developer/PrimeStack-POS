<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primestack_light_gray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primestack_primary"
            android:text="My Wallet"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="16dp"
            android:gravity="center" />

        <!-- Loading indicator -->
        <ProgressBar
            android:id="@+id/walletProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="32dp"
            android:visibility="gone" />

        <!-- Content (hidden while loading) -->
        <LinearLayout
            android:id="@+id/walletContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Balance card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/primestack_primary"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Available Balance"
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvWalletBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AED 0.00"
                    android:textColor="@color/white"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/tvWalletStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wallet: ACTIVE"
                    android:textColor="@color/primestack_success"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <!-- Stats row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@color/white"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:gravity="center"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:id="@+id/tvTotalCredited"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total received: AED 0.00"
                        android:textColor="@color/primestack_success"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@color/white"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:gravity="center"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:id="@+id/tvTotalDebited"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total paid out: AED 0.00"
                        android:textColor="@color/primestack_danger"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center" />
                </LinearLayout>
            </LinearLayout>

            <!-- Action buttons -->
            <Button
                android:id="@+id/btnRefreshWallet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Refresh Balance"
                android:textSize="14sp"
                android:padding="14dp"
                android:background="@color/white"
                android:textColor="@color/primestack_primary"
                android:layout_marginTop="16dp" />

            <Button
                android:id="@+id/btnRequestPayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Request Payout to Bank"
                android:textSize="15sp"
                android:textStyle="bold"
                android:padding="16dp"
                android:background="@color/primestack_success"
                android:textColor="@color/white"
                android:layout_marginTop="10dp" />

            <!-- Payout form (collapsed by default) -->
            <LinearLayout
                android:id="@+id/payoutForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Payout Request"
                    android:textColor="@color/primestack_secondary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Amount (AED) *"
                    android:textColor="@color/primestack_gray"
                    android:textSize="13sp" />
                <EditText
                    android:id="@+id/etPayoutAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. 500.00"
                    android:inputType="numberDecimal"
                    android:padding="12dp"
                    android:background="@color/primestack_light_gray"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Account Holder Name *"
                    android:textColor="@color/primestack_gray"
                    android:textSize="13sp" />
                <EditText
                    android:id="@+id/etAccountName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. PrimeStack LLC"
                    android:inputType="textPersonName"
                    android:padding="12dp"
                    android:background="@color/primestack_light_gray"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Account Number *"
                    android:textColor="@color/primestack_gray"
                    android:textSize="13sp" />
                <EditText
                    android:id="@+id/etAccountNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. 1234567890"
                    android:inputType="text"
                    android:padding="12dp"
                    android:background="@color/primestack_light_gray"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bank Name *"
                    android:textColor="@color/primestack_gray"
                    android:textSize="13sp" />
                <EditText
                    android:id="@+id/etBankName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. Emirates NBD"
                    android:inputType="text"
                    android:padding="12dp"
                    android:background="@color/primestack_light_gray"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IBAN (optional)"
                    android:textColor="@color/primestack_gray"
                    android:textSize="13sp" />
                <EditText
                    android:id="@+id/etIban"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="AE070331234567890123456"
                    android:inputType="text"
                    android:padding="12dp"
                    android:background="@color/primestack_light_gray"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Note (optional)"
                    android:textColor="@color/primestack_gray"
                    android:textSize="13sp" />
                <EditText
                    android:id="@+id/etPayoutNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Any note for the payout team"
                    android:inputType="textMultiLine"
                    android:lines="2"
                    android:padding="12dp"
                    android:background="@color/primestack_light_gray"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btnSubmitPayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Submit Payout Request"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:padding="15dp"
                    android:background="@color/primestack_primary"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your request will be reviewed and the bank transfer will be processed manually. You will be notified once complete."
                    android:textColor="@color/primestack_gray"
                    android:textSize="11sp"
                    android:layout_marginTop="10dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
