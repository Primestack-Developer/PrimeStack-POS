# PrimeStack 101.6 environment configuration
# Copy this to .env and fill in production values.

PORT=4000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/primestack1016?retryWrites=true&w=majority
TERMINAL_SECRET_KEY=replace_with_a_strong_random_key
VAULT_KEY=replace_with_64_hex_characters_32_bytes
JWT_SECRET=replace_with_a_strong_jwt_secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_secure_password
ADMIN_PRIVATE_KEY=replace_with_a_secure_private_key
ALERT_WEBHOOK=
WISE_API_KEY=replace_with_wise_api_key
STRIPE_WEBHOOK_SECRET=replace_with_stripe_webhook_secret
WISE_WEBHOOK_PUBLIC_KEY=
STRIPE_SECRET_KEY=replace_with_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=replace_with_stripe_publishable_key
REACT_APP_API_URL=https://primestack-pos.onrender.com
POS_BACKEND_URL=https://api.primestack.io
CORS_ORIGINS=https://primestack-dashboard.onrender.com
FINIX_API_URL=https://api.finix.com/v1
FINIX_USERNAME=replace_with_finix_username
FINIX_PASSWORD=replace_with_finix_password
NMI_API_URL=https://secure.nmi.com/api/transact.php
NMI_SECURITY_KEY=replace_with_nmi_security_key
FLOOR_LIMIT_AED=100
FLOOR_LIMIT_USD=30
OFFLINE_NFC_ENABLED=true
